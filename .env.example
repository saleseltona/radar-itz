# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - RADAR DE PAUTAS DE IMPERATRIZ (MA)
# Copie este arquivo para .env e preencha apenas as chaves que desejar ativar.
# NUNCA versione o arquivo .env nem exponha chaves nos relatórios ou logs.
# ==============================================================================

# 1. API de Busca Google Custom Search (Opcional - amplia busca na web aberta)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 2. SerpAPI / Bing Web Search API (Opcional - alternativa para busca web)
SERPAPI_KEY=
BING_SEARCH_API_KEY=

# 3. Meta / Instagram Graph API Oficial (Opcional - leitura autorizada de perfis públicos)
# Necessário para leitura completa de legendas/publicações do Instagram sem bloqueio de login.
# App Meta: "Radar de Pautas" (portfólio Nas Ruas). Passo a passo em docs/instagram-graph-api.md.
# - INSTAGRAM_GRAPH_TOKEN: token de usuário do FACEBOOK (começa com "EAA"), de longa duração.
#   NÃO use o token "IGAA..." (Login do Instagram): ele não tem Business Discovery.
#   Permissões: instagram_basic, instagram_manage_insights, pages_read_engagement,
#   pages_show_list, ads_read. Token de 60 dias: renovar antes de vencer.
# - INSTAGRAM_BUSINESS_ACCOUNT_ID: ID da conta profissional própria (nasruasdeitz) usada nas consultas.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Versão da Graph API (padrão v27.0)
INSTAGRAM_GRAPH_API_VERSION=v27.0

# 4. Parâmetros de Coleta e Agendamento
RADAR_TIMEOUT_SECONDS=15
RADAR_USER_AGENT="RadarDePautasImperatriz/1.0 (+https://imperatriz.ma.gov.br; Monitoramento Editorial)"
RADAR_CSV_DELIMITER=","
RADAR_SCHEDULE_TIMES="07:00,12:00,18:00"
# Busca no Google News RSS: pausa entre consultas e tempo total máximo (padrão 45s; 20s na Vercel)
RADAR_QUERY_DELAY_SECONDS=0.5
RADAR_QUERY_BUDGET_SECONDS=45

# 5. Supabase (PostgreSQL Persistente na Nuvem — Recomendado para Vercel)
# Crie o projeto no Supabase, execute supabase/schema.sql e preencha abaixo e na Vercel:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: 'auto' (usa Supabase se configurado, senão SQLite), 'supabase' ou 'sqlite'
RADAR_STORAGE_BACKEND=auto

# 6. Segurança do painel
# Token exigido nas ações que gravam dados (varredura, retificar, ignorar, arquivar, cadastrar fonte).
# Gere um valor longo e aleatório. Sem ele, essas ações só funcionam no acesso local direto (localhost).
# Na Vercel/Render, cadastre a mesma variável no painel do serviço.
RADAR_ADMIN_TOKEN=
