# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - RADAR DE PAUTAS DE IMPERATRIZ (MA)
# Copie este arquivo para .env e preencha apenas as chaves que desejar ativar.
# NUNCA versione o arquivo .env nem exponha chaves nos relatórios ou logs.
# ==============================================================================

# 1. API de Busca Google Custom Search (Opcional - amplia busca na web aberta)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 2. SerpAPI / Bing Web Search API (Opcional - alternativa para busca web)
SERPAPI_KEY=
BING_SEARCH_API_KEY=

# 3. Meta / Instagram Graph API Oficial (Opcional - leitura autorizada de perfis públicos)
# Necessário para leitura completa de legendas/publicações do Instagram sem bloqueio de login.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# 4. Parâmetros de Coleta e Agendamento
RADAR_TIMEOUT_SECONDS=15
RADAR_USER_AGENT="RadarDePautasImperatriz/1.0 (+https://imperatriz.ma.gov.br; Monitoramento Editorial)"
RADAR_CSV_DELIMITER=","
RADAR_SCHEDULE_TIMES="07:00,12:00,18:00"
